---
title: "Contato"
permalink: "/contato/index.html"
---
{% extends "base.njk" %}
{% block content %}
<section>
  <div class="container contato-grade">
    <div class="info-contato">
      <p class="rotulo" style="margin-bottom:16px;">Contato</p>
      <h2 style="margin-bottom:24px;">Vamos conversar</h2>
      <p><strong>Endereço</strong>{{ contato.endereco }}</p>
      <p><strong>Telefone</strong>{{ contato.telefone }}</p>
      <p><strong>E-mail</strong>{{ contato.email }}</p>
    </div>

    <form onsubmit="return false;">
      <div class="campo">
        <label for="nome">Nome</label>
        <input type="text" id="nome" placeholder="Seu nome completo">
      </div>
      <div class="campo">
        <label for="email">E-mail</label>
        <input type="email" id="email" placeholder="seu@email.com">
      </div>
      <div class="campo">
        <label for="mensagem">Mensagem</label>
        <textarea id="mensagem" placeholder="Como podemos ajudar?"></textarea>
      </div>
      <button type="submit" class="botao botao-principal" style="border:none;">Enviar mensagem</button>
    </form>
  </div>
</section>
{% endblock %}
